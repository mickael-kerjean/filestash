+    match errno {
+        0 => Ok(()),
+        2 => Err(io::Error::new(io::ErrorKind::PermissionDenied, "host not allowed")),
+        8 => Err(io::Error::new(io::ErrorKind::NotConnected, "bad socket descriptor")),
+        14 => Err(io::Error::new(io::ErrorKind::ConnectionRefused, "connection refused")),
+        28 => Err(io::Error::new(io::ErrorKind::InvalidInput, "invalid argument")),
